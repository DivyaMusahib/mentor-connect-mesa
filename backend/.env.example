# Mentor Connect Environment Configuration

# Application
PROJECT_NAME="Mentor Connect"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="mentor-connect-development-secure-session-key-replace-in-prod"
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"

# Database
# Default: Local SQLite for zero-friction development and evaluator testing.
# For production PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/mentor_connect
DATABASE_URL="sqlite:///./mentor_connect.db"

# Google OAuth (Student Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="mock-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="mock-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# Google Gemini AI (google-genai SDK)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# n8n Cloud Automation Integration
# Base URL of your n8n Cloud or self-hosted instance (e.g., https://your-workspace.app.n8n.cloud)
N8N_BASE_URL="https://mentor-connect-demo.app.n8n.cloud"
# Secret sent in X-N8N-Key header when FastAPI calls n8n
N8N_WEBHOOK_SECRET="mentor-connect-n8n-shared-secret-key"
# Secret expected in X-Callback-Signature/Token header when n8n calls back to FastAPI
FASTAPI_WEBHOOK_SECRET="mentor-connect-fastapi-callback-secret-key"

# Transcription Provider Configuration
# Options: fathom | simulation | recall_ai | fireflies
TRANSCRIPTION_PROVIDER="fathom"
TRANSCRIPTION_API_KEY=""
TRANSCRIPTION_WEBHOOK_SECRET="mentor-connect-transcript-secret"

# Demo Mode Settings
ENABLE_EVALUATOR_DEMO=True
