# Mentor Connect Frontend Environment Configuration

# Local Development:
# Leave empty so API requests use the relative /api/v1 prefix routed by the Vite dev proxy.
# VITE_API_BASE_URL=

# Production (e.g. Vercel, Netlify, Cloudflare Pages):
# Set to your deployed FastAPI backend URL (without trailing slash).
# Example: VITE_API_BASE_URL=https://mentor-connect-api.onrender.com
VITE_API_BASE_URL=
