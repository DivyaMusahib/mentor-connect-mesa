{
  "name": "05 Mentor Connect - Reschedule Meeting",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mentor-connect/reschedule",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-reschedule",
      "name": "Reschedule Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "mc-reschedule"
    },
    {
      "parameters": {
        "calendar": "primary",
        "operation": "update",
        "eventId": "={{ $json.body.payload.calendar_event_id }}",
        "updateFields": {
          "start": "={{ $json.body.payload.new_scheduled_at }}",
          "end": "={{ new Date(new Date($json.body.payload.new_scheduled_at).getTime() + 45*60000).toISOString() }}",
          "description": "={{ 'Mesa Mentorship Session (Rescheduled)\\nReason: ' + ($json.body.payload.reason || 'Requested change') }}"
        }
      },
      "id": "node-update-calendar",
      "name": "Update Google Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.1,
      "position": [440, 300],
      "credentials": {
        "googleCalendarOAuth2": {
          "id": "google_calendar_oauth2_account",
          "name": "Google Calendar Account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\": \"success\", \"message\": \"Google Calendar event successfully updated.\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-rescheduled",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Reschedule Webhook": {
      "main": [
        [
          {
            "node": "Update Google Calendar Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Google Calendar Event": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
